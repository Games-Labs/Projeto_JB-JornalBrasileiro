# Cabeçalhos HTTP aplicados pelo Cloudflare Pages.
# CSP: só scripts do próprio site + o script inline de tema (pelo hash). Se mudar uma vírgula
# desse script em qualquer página, recalcule o hash (veja docs/DEPLOY.md). Se trocar de projeto
# Supabase, troque o endereço em connect-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-RoOOJ0HE1mI5Nzaim6HvZVJ9zmIPQ5VRWm1X+jQUv34='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://cjzinwnyzcsxtwmgbcpo.supabase.co wss://cjzinwnyzcsxtwmgbcpo.supabase.co; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=3600

# Página que recebe o link de recuperação (o Cloudflare também a serve sem ".html")
/pages/redefinir-senha*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
