# Cabeçalhos HTTP aplicados pelo Cloudflare Pages.
# CSP: só scripts do próprio site + o script inline de tema (pelo hash). Se mudar uma vírgula
# desse script em qualquer página, recalcule o hash (veja docs/DEPLOY.md). Se trocar de projeto
# Supabase, troque o endereço em connect-src. challenges.cloudflare.com = CAPTCHA (Turnstile) do login.
# www.youtube-nocookie.com = player de vídeo das matérias (só carrega quando o leitor clica).
# As fontes ficam em assets/fonts (sem Google Fonts).
# Serviços (tempo, cotações, futebol, Hoje na História) passam pela Function /api/ext do próprio site,
# então connect-src continua só 'self' + Supabase. Escudos e fotos de terceiros entram por img-src https:.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-RoOOJ0HE1mI5Nzaim6HvZVJ9zmIPQ5VRWm1X+jQUv34=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://cjzinwnyzcsxtwmgbcpo.supabase.co wss://cjzinwnyzcsxtwmgbcpo.supabase.co; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# JS e CSS mudam a cada deploy: o navegador sempre confere com o servidor (resposta 304, sem
# baixar de novo, quando não mudou). Com max-age, o HTML novo chegava com o JS/CSS velho por até 1 h.
/assets/js/*
  Cache-Control: no-cache
/assets/css/*
  Cache-Control: no-cache

# Imagens, fontes, ícones e bibliotecas quase nunca mudam: 1 h no navegador
/assets/img/*
  Cache-Control: public, max-age=3600
/assets/fonts/*
  Cache-Control: public, max-age=3600
/assets/favicon/*
  Cache-Control: public, max-age=3600
/assets/vendor/*
  Cache-Control: public, max-age=3600

# Service worker (PWA): o navegador confere a versão nova a cada visita
/sw.js
  Cache-Control: no-cache

/assets/favicon/site.webmanifest
  Content-Type: application/manifest+json

# Página que recebe o link de recuperação (o Cloudflare também a serve sem ".html")
/pages/redefinir-senha*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
